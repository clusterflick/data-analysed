# Google Maps API key for coordinate validation
MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API key, used by find:venue-leads to assess discovered venues.
# The same key the scripts package uses; LLM_PROVIDER=openai swaps in
# OPENAI_API_KEY instead.
GEMINI_API_KEY=your_gemini_api_key_here
